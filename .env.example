# ========================
# Environment Variables
# Copy to .env and fill in
# ========================

# ---- API Gateway (Fastify) ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_agent
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal service communication
INTERNAL_SERVICE_TOKEN=your-internal-secret-token-change-in-production
AI_SERVICE_URL=http://localhost:8001

# ---- Python AI Microservice ----
PYTHON_PORT=8001
PYTHON_LOG_LEVEL=info

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_your-langsmith-api-key
LANGCHAIN_PROJECT=customer-support-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- OpenTelemetry ----
OTEL_SERVICE_NAME_API=api-gateway
OTEL_SERVICE_NAME_AI=ai-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=always_on

# ---- External Services (optional) ----
STRIPE_SECRET_KEY=sk_test_your-stripe-key
RESEND_API_KEY=re_your-resend-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
