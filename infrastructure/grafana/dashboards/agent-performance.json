    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "AI Microservice Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_service_call_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 AI Duration (s)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Cases Created vs Resolved",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cases_created_total[5m])) * 60",
          "legendFormat": "Cases Created/min",
          "refId": "C"
        },
        {
          "expr": "sum(rate(cases_resolved_total[5m])) * 60",
          "legendFormat": "Cases Resolved/min",
          "refId": "D"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Refund Requests by Outcome",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(refund_requests_total[1h])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "E"
        }
      ]
    },
    {
      "collapsed": false,
